# Anthropic API key. Required for `run` and `eval` against the live model.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Only needed if your key is "identity-linked" (issued via SSO under an
# organization with multiple workspaces). Leave blank for a standard
# personal API key. If a request fails with "anthropic-workspace-id is
# required...", find your workspace ID in the Console under
# Settings > Workspaces and set it here.
ANTHROPIC_WORKSPACE_ID=

# Claude model used for classification, reply generation, and evaluation.
CLAUDE_MODEL=claude-sonnet-5

# Max tokens for a single Claude completion.
CLAUDE_MAX_TOKENS=1024

# Path to the SQLite database file. Created automatically if it doesn't exist.
DATABASE_PATH=data/email_agent.db

# Pass criteria for the evaluation harness (1-5 scales unless noted).
EVAL_MIN_PROFESSIONALISM=4
EVAL_MIN_TONE_MATCH=4
EVAL_MIN_RELEVANCE=4
